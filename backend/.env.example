# Cấu hình môi trường cho Backend FastAPI
PROJECT_NAME="Sales and Warehouse Management System"
API_V1_STR="/api/v1"

# Khóa bí mật và thuật toán JWT
SECRET_KEY="super-secret-jwt-key-replace-with-secure-random-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cơ sở dữ liệu (SQLite cho Local Dev hoặc PostgreSQL cho Production)
DATABASE_URL="sqlite:///./sales_warehouse.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/sales_warehouse"

# Quy tắc bảo mật tài khoản (SCRUM-287)
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
